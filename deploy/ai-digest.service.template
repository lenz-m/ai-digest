[Unit]
Description=Weekly AI digest: fetch, rank, summarize, email
Documentation=https://github.com/lenz-m/ai-digest
# Feeds and the Anthropic API both need DNS. network-online (not network)
# because the plain target fires before an address is actually usable.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__

# Deliberately NOT EnvironmentFile=.env.
# pipeline/config.py already calls load_dotenv() unconditionally, and the two
# parsers disagree about quoting: systemd would hand Python an app-specific
# password with the literal quote characters still attached, producing a 535
# auth failure that looks like a wrong password. WorkingDirectory above is
# what lets python-dotenv find .env. One parser, not two.

# THE TRAP THIS UNIT EXISTS TO AVOID:
# the default batch path polls for up to AI_DIGEST_BATCH_MAX_WAIT (7200s).
# systemd's default TimeoutStartSec for Type=oneshot is 90 SECONDS, which
# would SIGTERM the run mid-poll every single week, with no email and a
# confusing "timeout" in the journal. 3h leaves headroom over the 2h ceiling.
TimeoutStartSec=10800

# The vault note filename starts with an emoji (U+1F5DE). Under systemd the
# locale is C unless told otherwise. PEP 538 coerces C -> C.UTF-8 on modern
# Python, but relying on an implicit coercion for filename encoding is how
# you get mojibake in the archive. Be explicit.
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# Unbuffered so the journal shows progress during the long batch poll rather
# than dumping everything at exit.
Environment=PYTHONUNBUFFERED=1

# Absolute path on purpose. systemd's PATH does not include ~/.local/bin,
# where uv installs itself, so a bare `uv` here is the classic status=203
# EXEC failure that works fine when you test it by hand in a login shell.
#
# No --sync: the batch path is half price and a weekly job has zero latency
# pressure. No --limit-sources: that is a dev flag and run.py exits 2 if it
# is combined with --apply.
ExecStart=__UV__ run python -m pipeline.run --apply

# No automatic retry. Exit 3 is a fatal API error (billing or auth) and exit 1
# is a failed send after send.py has already exhausted its own 5s/30s/120s
# retry ladder. Both mean "a human needs to look", not "try again in a minute";
# hammering iCloud with repeated bad-credential attempts risks throttling the
# account, turning a broken week into a broken month.

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
