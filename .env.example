# --- Pi only ---
# On the Mac, don't put real secrets in .env -- use macOS Keychain instead
# (see scripts/run_with_secrets.sh) so nothing sits in plaintext in this
# project folder. .env is the PI's approach specifically, since the Pi has
# no Keychain equivalent -- see CLAUDE.md "Secrets" for the full rationale.
#
# On the Pi: copy this file to .env, chmod 600, owned by the pi user,
# loaded automatically by pipeline/config.py via python-dotenv.

ANTHROPIC_API_KEY=sk-ant-...

# Stage 4 (email send). iCloud app-specific password, NOT your real Apple ID
# password -- generate one at appleid.apple.com under Sign-In and Security >
# App-Specific Passwords. On the Mac these two live in Keychain as
# ai-digest-smtp-username / ai-digest-smtp-app-password; there is no Mac .env.
SMTP_USERNAME=you@icloud.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where the digest goes and who it comes from. AI_DIGEST_FROM must be an
# address this iCloud account actually owns -- an unrecognised From gets a
# hard 550 from iCloud, not a retryable error. AI_DIGEST_TO is parsed as a
# comma-separated list, though there is one recipient today.
AI_DIGEST_TO=you@icloud.com
AI_DIGEST_FROM=you@icloud.com

# Persist the seen-set after a successful send. Ships OFF: two known defects
# (score-stage failures at 15-23%, and the max_survivors cap) silently drop
# content, and committing the seen-set turns those from "returns next week"
# into permanent deletion. Turn on once both are verified fixed. The
# --commit-seen flag does the same thing for a one-off run.
# AI_DIGEST_COMMIT_SEEN=true
