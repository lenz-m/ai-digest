.env
# ~/.gitignore_global has `.env.*`, which swept up .env.example too -- so the
# template CLAUDE.md says is "committed" had in fact never been tracked. A
# per-directory .gitignore outranks core.excludesFile, so this re-includes it.
# The Pi's setup depends on this file; it holds placeholders only.
!.env.example
.venv/
logs/
outbox/
preview/
__pycache__/
*.pyc

data/*
!data/manual_sources.tsv

# The two exceptions below are HAND-AUTHORED CONFIG (feed overrides, trust
# tiers, human_override entries) that happens to live in cache/ -- that is the
# only reason they are tracked. Everything else here is derived output and
# stays ignored. In particular cache/last_run_scored.json holds full article
# summaries and scores for ~60 items from the last run: derived data, rewritten
# every run, never to be committed. Do not add an exception for it.
cache/*
!cache/trust_tiers.json
!cache/fetch_strategy.json
.claude/settings.local.json
